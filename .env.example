# Contact form (app/api/contact/route.ts)
# Copy to .env.local for development, and set the same variables on the hosting provider.
# Use the SMTP settings of the mailbox that should send the enquiries.

SMTP_HOST=smtp.example.it
# 465 = SSL/TLS, 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=info@baywatchtravel.it
SMTP_PASS=

# Optional. Where enquiries are delivered (default: info@baywatchtravel.it)
CONTACT_TO=
# Optional. Sender address (default: SMTP_USER). Most providers require it to match the mailbox.
CONTACT_FROM=
